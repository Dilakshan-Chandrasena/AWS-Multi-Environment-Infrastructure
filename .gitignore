
# Terraform working directories
**/.terraform/*

# Terraform state files (may contain sensitive data)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files
# Commit only explicitly reviewed, non-sensitive examples
*.tfvars
*.tfvars.json
!*.tfvars.example

# Terraform plans (may contain sensitive values)
*.tfplan
tfplan
tfplan.*
planout

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# Terraform state lock information
.terraform.tfstate.lock.info

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx

# Environment variables and local secrets
.env
.env.*
!.env.example
!.env.*.example

# AWS credentials and local CLI configuration
.aws/
credentials
config.local

# Python virtual environments
.venv/
venv/
env/

# Python cache and test artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Build and distribution artifacts
build/
dist/
*.egg-info/

# Logs
*.log

# IDE and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db
